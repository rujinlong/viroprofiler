/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    arm64 profile — locally built images
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The images published on Docker Hub are amd64-only, so on aarch64 hosts the pipeline has
    to use images built from `docker/` on the host itself. Build them with:

        bash docker/build_arm64.sh

    which produces the SIF files this profile points at. See docs/dev/ARM64.md for what is
    and is not portable to aarch64.

    Usage:
        nextflow run main.nf -profile apptainer,arm64_local ...
        nextflow run main.nf -profile apptainer,arm64_local --sif_dir /path/to/sifs ...
----------------------------------------------------------------------------------------
*/

params {
    // Where `docker/build_arm64.sh` writes the SIF files.
    sif_dir   = "${HOME}/singularity/viroprofiler"

    // iPHoP cannot be built for aarch64: every release pins blast 2.12, tensorflow 2.7,
    // r-base 4.0 and python 3.8, none of which has a linux-aarch64 build. DeepVirFinder
    // pins theano 1.0.3 and keras 2.2.4, and theano has no linux-aarch64 build at all.
    use_iphop = false
    use_dvf   = false
}

process {
    withLabel: viroprofiler_base       { container = "${params.sif_dir}/viroprofiler-base.sif"       }
    withLabel: viroprofiler_abundance  { container = "${params.sif_dir}/viroprofiler-abundance.sif"  }
    withLabel: viroprofiler_bracken    { container = "${params.sif_dir}/viroprofiler-bracken.sif"    }
    withLabel: viroprofiler_vibrant    { container = "${params.sif_dir}/viroprofiler-vibrant.sif"    }
    withLabel: viroprofiler_binning    { container = "${params.sif_dir}/viroprofiler-binning.sif"    }
    withLabel: viroprofiler_dvf        { container = "${params.sif_dir}/viroprofiler-dvf.sif"        }
    withLabel: viroprofiler_geneannot  { container = "${params.sif_dir}/viroprofiler-geneannot.sif"  }
    withLabel: viroprofiler_replicyc   { container = "${params.sif_dir}/viroprofiler-replicyc.sif"   }
    withLabel: viroprofiler_vcontact3  { container = "${params.sif_dir}/viroprofiler-vcontact3.sif"  }
    withLabel: viroprofiler_virsorter2 { container = "${params.sif_dir}/viroprofiler-virsorter2.sif" }
    withLabel: viroprofiler_vpfkit     { container = "${params.sif_dir}/viroprofiler-viewer.sif"     }

    // The vendored nf-core modules hardcode amd64-only quay.io/biocontainers images.
    withName: FASTQC                      { container = "${params.sif_dir}/viroprofiler-qc.sif" }
    withName: FASTP                       { container = "${params.sif_dir}/viroprofiler-qc.sif" }
    withName: SPADES                      { container = "${params.sif_dir}/viroprofiler-qc.sif" }
    withName: MULTIQC                     { container = "${params.sif_dir}/viroprofiler-qc.sif" }
    withName: CUSTOM_DUMPSOFTWAREVERSIONS { container = "${params.sif_dir}/viroprofiler-qc.sif" }
}
