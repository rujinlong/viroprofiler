/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ViroProfiler Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {
    // TODO nf-core: Specify your pipeline's command line flags
    // Input options
    input                         = null
    outdir                        = "output"
    // Last stage to run. `setup` builds databases and reads no samplesheet; the rest are
    // cumulative -- each runs every earlier stage and then its own. See
    // WorkflowViroprofiler.MODE_STAGE.
    mode                          = "all"                // ["setup", "fastqc", "fastp", "contiglib", "all"]
    // Unset, or a path to a contig FASTA, which routes the run to CONTIGANNO. `null`
    // rather than `false`: it is a path, the strict parser hands a command-line value over
    // as a String, and a String "false" is true to Groovy.
    input_contigs                 = null
    // Per-sample phenotypes joined into the TSE's colData (CSV/TSV/XLSX; one column of
    // sample names matching the samplesheet). It cannot live in the samplesheet itself:
    // INPUT_CHECK rejects anything that is not exactly three columns. Without it colData
    // holds nothing but the sample name, and no group-wise analysis downstream is possible.
    sample_metadata               = null
    reads_type                    = "raw"                // ["raw", "clean"]
    single_end                    = false                // true for single-end reads

    // =============================  Database  ====================================
    db                            = "${env('HOME')}/viroprofiler"
    // Extra host paths to bind into every container, comma-separated. Needed when entries
    // under --db are symlinks pointing outside it, e.g. a shared read-only database tree:
    //   --container_binds /shared/db,/scratch/refs
    container_binds               = null

    // =============================  ViroProfiler modules  ====================================
    use_abricate                  = false
    use_checkamg                  = true    // CheckAMG; the auxiliary-gene (AMG/AReG/APG) caller
    use_decontam                  = false
    use_eggnog                    = false
    use_dram                      = true
    use_iphop                     = true
    use_kraken2                   = false
    use_phamb                     = false
    use_vitap                     = true    // highest-priority taxonomy source; needs a 1.3 GB database
    // VIBRANT contributes a third opinion to the candidate-virus union and a genome
    // quality call to the TSE, and nothing else -- geNomad now does detection and
    // CheckAMG does auxiliary genes. Left on so that switching detectors does not
    // silently change which contigs are called viral; turn it off to drop ~30 GB of
    // database and one HMM search per run. Its own AMG tables are not consumed by the
    // pipeline and should not be used: their false-positive rate is what motivated
    // CheckAMG.
    use_vibrant                   = true

    // =============================  Decontamination  =============================
    decontam                      = null
    decontam_min_similarity       = 0.95
    // Defaults to <db>/contamination_refs/hg19/ref, resolved at run time so that it follows
    // --db. Set explicitly to point at a reference index built elsewhere.
    contamref_idx                 = null

    // =============================  Contig library  ==============================
    assembler                     = "spades"
    assemblies                    = "scaffolds"   // ["contigs","scaffolds"]
    contig_minlen                 = 3000
    // MIUViG species thresholds, applied by Vclust in CONTIGLIB_CLUSTER. Percent
    // identity is measured over the aligned region only; coverage is the aligned
    // fraction of the SHORTER contig, with no constraint on the longer one, so a
    // short contig contained in a longer one is absorbed by it.
    contig_cluster_min_similarity = 95            // 0-100
    contig_cluster_min_coverage   = 85            // 0-100

    // =============================   Gene library   ==============================
    prot_cluster_min_similarity   = 0.7    // Minimum similarity of protein AA seqs in the same cluster
    prot_cluster_min_coverage     = 0.9    // Minimum similarity of protein AA seqs in the same cluster
    gene_cluster_min_similarity   = 0.9    // Minimum similarity of gene DNA seqs in the same cluster
    gene_cluster_min_coverage     = 0.9    // Minimum similarity of gene DNA seqs in the same cluster

    // =============================  Binning  =====================================
    // "vrhyme", "phamb" or "false" -- the three values nextflow_schema.json allows. The
    // off value is the *string* "false", not the boolean: a command-line value arrives as
    // a String under the strict parser, and a non-empty String is true to Groovy, so a
    // boolean default would make `--binning false` turn binning on. Nothing tests this
    // parameter for truth; the workflow matches it against the two binner names.
    binning                       = 'false'
    binning_minlen_contig         = 5000
    binning_minlen_bin            = 5000

    // =============================  Viral detection  =============================
    // virsorter2_groups          = "dsDNAphage,NCLDV,RNA,ssDNA,lavidaviridae"
    virsorter2_groups             = "dsDNAphage"
    // geNomad's post-classification filtering. ["default", "conservative", "relaxed"]
    // "conservative" tightens the false-positive filters, "relaxed" disables them.
    //
    // Note on "relaxed": VIRCONTIGS_PRE takes every contig geNomad reports, whereas
    // vpfkit's create_vpftse_vir() only counts geNomad evidence at virus_score >= 0.7.
    // geNomad's default --min-score is also 0.7, so the two agree under "default" and
    // "conservative"; "relaxed" lifts the score floor and can therefore put a contig in
    // the candidate set that the final viral TSE does not count geNomad as supporting.
    genomad_preset                = "default"
    // Split geNomad's MMseqs2 marker search into N chunks. 0 leaves it unsplit; raise it
    // if the search runs out of memory, at the cost of speed.
    genomad_splits                = 0

    // =============================  Auxiliary genes  =============================
    // Minimum CheckAMG AMG weight for a putative auxiliary gene to be reported. Higher
    // is more conservative; CheckAMG's own default is 0.6.
    checkamg_min_weight           = 0.6

    // =============================  Taxonomy  ====================================
    contig_minlen_vcontact3       = 10000
    vcontact3_db_version          = 232

    // =============================  Replication cycle  ===========================
    replicyc                      = "bacphlip"    // ["replidec","bacphlip"]

    // kraken2 + bracken
    kraken2_db                    = "viral"
    kraken2_clean                 = true
    save_output_fastqs            = false
    save_reads_assignment         = false

    // References

    // MultiQC options
    multiqc_config                = null
    multiqc_title                 = null
    max_multiqc_email_size        = '25.MB'

    // Other options
    publish_dir_mode              = 'copy'
    email                         = null
    email_on_fail                 = null
    plaintext_email               = false
    monochrome_logs               = false
    help                          = false
    validate_params               = true
    show_hidden_params            = false
    // trace_timestamp is assigned by this file, after the profiles block, and is not a
    // user-facing option; it is in the params namespace only because that is the one way
    // the strict config language lets a value reach several config scopes.
    schema_ignore_params          = 'single_end,decontam,trace_timestamp'
    enable_conda                  = false

    // Config options
    custom_config_version         = 'master'
    custom_config_base            = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_description    = null
    config_profile_contact        = null
    config_profile_url            = null
    config_profile_name           = null

    // Max resource options
    // Defaults only, expecting to be overwritten
    max_memory                    = '128.GB'
    max_cpus                      = 16
    max_time                      = '120.h'

}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load the DSL2 per-module options (container assignments, publishDir). This must come
// BEFORE `profiles`, so that a profile can override a container image -- the later include
// always wins in Nextflow.
includeConfig 'conf/modules.config'

// Load nf-core custom profiles from different Institutions
//try {
//    includeConfig "${params.custom_config_base}/nfcore_custom.config"
//} catch (Exception e) {
//    System.err.println("WARNING: Could not load nf-core/config profiles: ${params.custom_config_base}/nfcore_custom.config")
///}


profiles {
    debug { process.beforeScript = 'echo $HOSTNAME' }
    standard {
        process.executor       = 'local'
        process.cpus           = 1
        process.memory         = 1.GB
    }
    conda {
        params.enable_conda    = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    podman {
        podman.enabled         = true
        docker.enabled         = false
        singularity.enabled    = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    shifter {
        shifter.enabled        = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        charliecloud.enabled   = false
    }
    charliecloud {
        charliecloud.enabled   = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
    }
    // aarch64 hosts: the published images are amd64-only, so use locally built ones.
    // See docs/dev/ARM64.md.
    arm64_local { includeConfig 'conf/arm64_local.config' }
    test { includeConfig 'conf/test.config' }
    test_denglab {
        includeConfig 'conf/test.config'
        includeConfig 'custom.config'
    }
    test_stub { includeConfig 'conf/test_stub.config' }

    // Custom profiles for the denglab
    charliecloud_denglab {
        charliecloud.runOptions = "-b /dss -b /gpfs"
    }
    slurm_denglab2 {
        process.executor       = 'slurm'
        process.cpus           = { 1 * task.attempt }
        process.memory         = { 2.GB * task.attempt }
        process.queue          = 'serial_std'
        process.clusterOptions = '--clusters=serial'
        process.time           = { 12.h * task.attempt }
    }
}


// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

process {
    // The database root is referenced as a bare path inside process scripts (CheckV,
    // VirSorter2, VIBRANT, DRAM, mmseqs taxonomy, iPHoP, ...). It is not a staged Nextflow
    // input, so `autoMounts` does not cover it and it must be bind-mounted explicitly.
    // A closure is required: it is evaluated per task, after `--db` on the command line has
    // been applied, whereas a plain string would freeze to the default value.
    containerOptions = {
        // Bind the literal path AND the path with symlinks resolved. Tools that store
        // absolute paths in their own config (DRAM, for one, calls realpath) write the
        // resolved form, so binding only the literal path leaves them pointing at
        // something the container cannot see.
        def db_file = new File(params.db as String)
        def paths = [ db_file.getAbsolutePath(), db_file.getCanonicalPath() ] as LinkedHashSet
        if (params.container_binds) {
            paths += (params.container_binds as String).tokenize(',').collect { b -> b.trim() }.findAll { b -> b }
        }
        // An if/else chain rather than a switch: the strict config language has no
        // switch statement.
        def engine = workflow.containerEngine
        if (engine == 'docker' || engine == 'podman') {
            return paths.collect { p -> "-v ${p}:${p}" }.join(' ')
        }
        else if (engine == 'singularity' || engine == 'apptainer') {
            return paths.collect { p -> "-B ${p}" }.join(' ')
        }
        else if (engine == 'charliecloud') {
            return paths.collect { p -> "-b ${p}" }.join(' ')
        }
        else {
            return null      // shifter has no per-task bind option
        }
    }

    withLabel: setup {
        // Database construction is dominated by mmseqs msa2profile, mmseqs createindex and
        // hmmpress, all of which scale with threads; one CPU made a 3.5-hour DRAM build out
        // of what is mostly parallel work. `process.resourceLimits` still honours
        // --max_cpus on small hosts.
        cpus = { 8 * task.attempt }
        memory = { 16.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: ABRICATE {
        cpus = { 1 * task.attempt }
        memory = { 2.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: ABUNDANCE {
        cpus = { 1 * task.attempt }
        memory = { 1.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: BACPHLIP {
        ext.args = "--multi_fasta"
        cpus = { 1 * task.attempt }
        memory = { 2.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: BRACKEN {
        cpus = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time = { 24.h * task.attempt }
    }

    withName: BRACKEN_COMBINEBRACKENOUTPUTS {
        cpus = { 1 * task.attempt }
        memory = { 1.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: CHECKV {
        cpus = { 1 * task.attempt }
        memory = { 10.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: CONTIGLIB {
        cpus = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    // Every Vclust stage takes `-t $task.cpus`, and the two that dominate the runtime --
    // the Kmer-db prefilter and the LZ-ANI alignment of the pairs that survive it -- are
    // both threaded. This process also sees the whole pooled contig library rather than
    // the viral subset, so its memory scales with the k-mer table of every contig
    // assembled, not with the number of viruses found.
    withName: CONTIGLIB_CLUSTER {
        cpus = { 4 * task.attempt }
        memory = { 12.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: CONTIGINDEX {
        cpus = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: DB_DRAM {
        cpus ={ 2 * task.attempt }
        memory = { 10.GB * task.attempt }
        time = { 30.h * task.attempt }
    }

    withName: DB_KRAKEN2 {
        cpus = { 1 * task.attempt }
        memory = { 1.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: DB_VIBRANT {
        cpus = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: DB_VIRSORTER2 {
        cpus = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: DECONTAM {
        ext.args = 'maxindel=1 bwr=0.16 bw=12 quickmatch fast minhits=2 qtrim=rl trimq=10 pigz=True untrim'
        cpus = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: DRAMV {
        cpus = { 1 * task.attempt }
        memory = { 6.GB * task.attempt }
        time = { 30.h * task.attempt }
    }

    // geNomad's cost is dominated by an MMseqs2 marker search, which threads well and is
    // the memory-hungry step; --genomad_splits trades memory for time if 16 GB is not
    // enough for the library at hand.
    withName: GENOMAD {
        cpus = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
        time = { 20.h * task.attempt }
    }

    // CheckAMG enforces `-m` on itself and aborts on exceeding it, and the process passes
    // task.memory through, so this figure is a real ceiling rather than a hint.
    withName: CHECKAMG {
        cpus = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
        time = { 20.h * task.attempt }
    }

    withName: EMAPPER {
        cpus = { 1 * task.attempt }
        memory = { 10.GB * task.attempt }
        time = { 30.h * task.attempt }
    }

    withName: FASTQC {
        ext.args = '--quiet'
        cpus = { 1 * task.attempt }
        memory = { 2.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: FASTP {
        ext.args = "--detect_adapter_for_pe -p -n 1 -l 30 -5 -W 4 -M 20 -r -c -g -x"
        cpus = { 1 * task.attempt }
        memory = { 2.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: GENEPRED {
        cpus = { 1 * task.attempt }
        memory = { 2.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: MAPPING2CONTIGS {
        cpus = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: MAPPING2CONTIGS2 {
        cpus = { 1 * task.attempt }
        memory = { 6.GB * task.attempt }
        time = { 24.h * task.attempt }
    }

    withName: MICOMPLETEDB {
        cpus = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: MULTIQC {
        cpus = { 1 * task.attempt }
        memory = { 1.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: NRSEQS {
        cpus = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: PHAMB_RF {
        cpus = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: REPLIDEC {
        cpus = { 2 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 30.h * task.attempt }
    }

    withName: SPADES {
        cpus = { 1 * task.attempt }
        memory = { 10.GB * task.attempt }
        time = { 30.h * task.attempt }
    }

    withName: TAXONOMY_MERGE {
        cpus = { 1 * task.attempt }
        memory = { 1.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: TAXONOMY_VCONTACT3 {
        cpus = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
        time = { 30.h * task.attempt }
    }

    withName: VAMB {
        cpus = { 1 * task.attempt }
        memory = { 6.GB * task.attempt }
        time = { 20.h * task.attempt }
    }

    withName: VIBRANT {
        cpus = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 20.h * task.attempt }
    }

    withName: VIRALHOST_IPHOP {
        cpus = { 1 * task.attempt }
        memory = { 6.GB * task.attempt }
        time = { 40.h * task.attempt }
    }

    withName: VIRSORTER2 {
        cpus = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 40.h * task.attempt }
    }

    withName: VOGDB {
        cpus = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 12.h * task.attempt }
    }

    withName: VRHYME {
        ext.args = "--method longest"
        cpus = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// The ceiling every resource request is clamped to. It replaces the nf-core `check_max()`
// helper, which the strict config language cannot express: it has no function
// declarations, and a class in `lib/` is not reachable from a config closure either --
// `Utils.checkMax(...)` there resolves `Utils` to a ConfigObject.
//
// This assignment must stay AFTER the `profiles` block. The map is evaluated where it is
// written rather than per task, so the same lines in conf/base.config would freeze to the
// defaults in `params` above and silently ignore the lower ceilings set by `test`,
// `test_stub` and custom.config. A `--max_cpus` on the command line is applied before the
// config is resolved and overrides both.
process.resourceLimits = [
    cpus:   params.max_cpus,
    memory: params.max_memory,
    time:   params.max_time
]

// NOTE: `${params.outdir}` is interpolated here, after the `profiles` block, so that a
// profile or a `--outdir` on the command line is reflected. Do not reintroduce a
// `params.tracedir` defined inside the `params` block: it is interpolated too early and
// freezes to the default `outdir`.
//
// The timestamp is a param and not a local variable because the strict config language
// declares no variables, and `params` is the only channel by which one config setting can
// carry a value into another.
params.trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled   = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_timestamp}.html"
}
report {
    enabled   = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_timestamp}.html"
}
trace {
    enabled   = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_timestamp}.txt"
}
dag {
    enabled   = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_timestamp}.html"
}

manifest {
    name            = 'ViroProfiler'
    author          = 'Jinlong Ru'
    homePage        = 'https://github.com/deng-lab/viroprofiler'
    description     = 'A containerized bioinformatics pipeline for viral metagenomic data analysis'
    mainScript      = 'main.nf'
    // The config and the workflow scripts are written in Nextflow's strict language, which
    // became the default parser in 26.04. Under an older release the run dies at startup
    // on `env()` in the params block, with a parse error that names a config line rather
    // than the cause.
    nextflowVersion = '>=26.04.0'
    version         = '1.0.1'
}
